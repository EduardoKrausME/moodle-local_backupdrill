<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/backupdrill/db" VERSION="20261014" COMMENT="Backup restoration laboratory records" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_backupdrill_plan" COMMENT="Persistent restoration plans">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="fileid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="intervalhours" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="24"/>
        <FIELD NAME="nextrun" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="maxseconds" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1800"/>
        <FIELD NAME="maxbytes" TYPE="int" LENGTH="20" NOTNULL="true" DEFAULT="536870912"/>
        <FIELD NAME="maxattempts" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="2"/>
        <FIELD NAME="autocleanup" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="duedrills" UNIQUE="false" FIELDS="enabled,nextrun"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_backupdrill_run" COMMENT="Append-only drill results">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="planid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="status" TYPE="char" LENGTH="40" NOTNULL="true" DEFAULT="pending"/>
        <FIELD NAME="attempt" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="started" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="finished" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="errorcode" TYPE="char" LENGTH="80" NOTNULL="false"/>
        <FIELD NAME="reportjson" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="plan" TYPE="foreign" FIELDS="planid" REFTABLE="local_backupdrill_plan" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="runstatus" UNIQUE="false" FIELDS="status,timecreated"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_backupdrill_art" COMMENT="Ownership fence for disposable courses">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="runid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="token" TYPE="char" LENGTH="64" NOTNULL="true"/>
        <FIELD NAME="shortname" TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="deletedat" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="run" TYPE="foreign" FIELDS="runid" REFTABLE="local_backupdrill_run" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="uniqueowned" UNIQUE="true" FIELDS="courseid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
